# ---------------------------------------------------------------------------
# Secrets — never commit. Config comes from environment variables only.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
id_rsa*
id_ed25519*
secrets/
credentials.json
service-account*.json

# Token and credential caches. MSAL writes one of these once Microsoft Entra ID
# is introduced; the cloud CLIs write the rest. All contain live credentials.
*.token
*.token.json
token_cache*.json
.msal_cache*
.azure/
.aws/
.secrets/
*.netrc
.netrc

# ---------------------------------------------------------------------------
# Imported client data. Vendor inventory files, catalog extracts and exports are
# commercially sensitive and are business data, not source code. Blocked by
# extension so a file dropped into the repo to "try something" cannot be
# committed by accident; test fixtures are allowed back in explicitly.
# ---------------------------------------------------------------------------
*.csv
*.xlsx
*.xls
*.xlsm
*.pbix
data/
exports/
extracts/
!backend/tests/**/fixtures/**
!backend/tests/fixtures/**
!**/fixtures/**/*.csv
!**/fixtures/**/*.xlsx
!frontend/public/vendor-roster-template.csv

# ---------------------------------------------------------------------------
# Retained import files. Raw files are business data, not source code, and may
# contain commercially sensitive vendor pricing. Directories are kept, contents
# are never committed. See docs/decisions/0004-retain-raw-import-files-unchanged.md
# ---------------------------------------------------------------------------
storage/**
!storage/
!storage/raw/
!storage/processed/
!storage/rejected/
!storage/**/.gitkeep

